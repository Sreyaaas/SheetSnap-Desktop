# =============================================================================
# SheetSnap Desktop — Environment Configuration
# =============================================================================
# SheetSnap operates 100% offline by default using local ONNX OCR.
# Adding a GEMINI_API_KEY enables intelligent auto-fallback on complex/low-confidence
# tables and allows manual "Force AI Mode" in the UI.
# Get a free key at: https://aistudio.google.com/
# =============================================================================

# Google Gemini API Key (Free tier: 1,500 requests/day)
GEMINI_API_KEY=AIzaSyCPte8zaw7JQFsFVna9deVwP4bQ24tUySA

# Model identifier (recommended: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Confidence threshold (0-100). If local engine scores below this, it automatically diverts to Gemini.
GEMINI_CONFIDENCE_THRESHOLD=70

# Master toggle for Gemini VLM feature (True/False)
GEMINI_ENABLED=True
